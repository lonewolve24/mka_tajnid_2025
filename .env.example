# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env for local development (never commit .env to git)
# On Railway, set these in: your service → Variables tab
# ─────────────────────────────────────────────────────────────────────────────

# Django secret key – generate a new one for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production!
DEBUG=False

# ── Database ──────────────────────────────────────────────────────────────────
# Railway gives you TWO URLs for the Postgres service.  Pick the right one:
#
#   INTERNAL URL  →  use this in the Railway "Variables" tab on your web service
#                    (stays inside Railway's private network, faster & free)
#   Format:  postgresql://USER:PASSWORD@INTERNAL_HOST:PORT/DATABASE
#   Example: postgresql://postgres:abc123@postgres.railway.internal:5432/railway
#
#   EXTERNAL URL  →  use this on your LOCAL machine or external tools (e.g. DBeaver)
#                    (goes over the public internet, requires TCP proxy to be enabled)
#   Format:  postgresql://USER:PASSWORD@roundhouse.proxy.rlwy.net:PORT/DATABASE
#   Example: postgresql://postgres:abc123@roundhouse.proxy.rlwy.net:54321/railway
#
# Where to find both URLs in Railway:
#   1. Open your Railway project
#   2. Click the Postgres service
#   3. Go to the "Connect" tab
#   4. Copy "Private URL" (internal) or "Public URL" (external)

# ── On Railway (web service Variables tab) ────────────────────────────────────
# Add a variable reference: DATABASE_URL → ${{Postgres.DATABASE_URL}}
# Railway will automatically fill in the internal URL at deploy time.

# ── For local development (.env file on your machine) ─────────────────────────
# Paste the EXTERNAL URL here so your local Django can reach Railway's DB,
# OR just leave it blank to use the local SQLite database instead (easier).
DATABASE_URL=
